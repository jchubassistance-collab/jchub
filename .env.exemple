# URL publique de l'application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase client (valeurs visibles côté navigateur)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin (serveur uniquement)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Authentification Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Supabase serveur (réservé aux futures opérations serveur ; ne jamais préfixer NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Brevo
BREVO_API_KEY=your_brevo_api_key
BREVO_NEWSLETTER_LIST_ID=your_brevo_list_id
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=JcHub
CONTACT_NOTIFICATION_EMAIL=admin@example.com

# Giscus (optionnel, commentaires des articles)
NEXT_PUBLIC_GISCUS_REPOSITORY=owner/repository
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=your_giscus_repository_id
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=your_giscus_category_id

# Tâches cron et webhooks
CRON_SECRET=replace_with_a_long_random_secret

# MTN MoMo API (optionnel, sandbox par défaut)
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
# Dans le portail MTN: API User (UUID) et API Key générée pour cet utilisateur.
MTN_API_USER=your_mtn_api_user_uuid
MTN_API_KEY=your_mtn_api_key
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_CALLBACK_URL=http://localhost:3000/api/webhooks/mtn
MTN_ENV=sandbox

# Import de livres audio (optionnel)
FFMPEG_PATH=ffmpeg
