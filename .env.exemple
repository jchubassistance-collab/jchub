# Exemple de configuration JcHub
# Copiez ce fichier en .env.local et remplacez les valeurs d'exemple par vos vraies clés.
# Ce fichier est conçu pour être versionné dans Git.

NEXT_PUBLIC_SITE_URL=https://example.com

ADMIN_EMAILS=admin@example.com,dev@example.com

# Firebase / Google
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890
FIREBASE_PROJECT_ID=demo-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-demo@demo-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_DEMO_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-demo@demo-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_DEMO_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Analytics / SEO
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_PROPERTY_ID=123456789

# Brevo / newsletter
BREVO_API_KEY=xkeysib-your-demo-key
BREVO_SENDER_EMAIL=hello@jchub.dev
BREVO_SENDER_NAME=JcHub
CONTACT_NOTIFICATION_EMAIL=hello@jchub.dev

# LinkedIn
LINKEDIN_CLIENT_ID=demo-linkedin-client-id
LINKEDIN_CLIENT_SECRET=demo-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=demo-linkedin-access-token

# X / Twitter
X_API_KEY=demo-x-api-key
X_API_SECRET=demo-x-api-secret
X_BEARER_TOKEN=demo-x-bearer-token

# Cron / internal
CRON_SECRET=replace-with-a-random-demo-secret

# AI / document services
AI_PROVIDER=gemini
GEMINI_API_KEY=demo-gemini-api-key
# Recherche d'outils assistée : Mistral en principal, OpenRouter (modèles gratuits) en secours
MISTRAL_API_KEY=demo-mistral-api-key
# Écart minimal entre deux appels Mistral (ms) ; mettre 30000 si ton offre limite à 2 requêtes/minute
MISTRAL_MIN_INTERVAL_MS=2000
OPENROUTER_API_KEY=demo-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
# Création d'outils par IA depuis Admin > Outils : Gemini écrit le code, une Pull Request GitHub
# est ouverte, Vercel construit un aperçu, puis tu approuves et programmes la mise en ligne.
# Utilise GITHUB_TOKEN, GITHUB_OWNER et GITHUB_REPOSITORY (nom du dépôt seul), comme la publication
# sociale. GITHUB_TOOLS_TOKEN, facultatif, accepte un jeton dédié plus restreint (Contents et Pull
# requests en écriture, Deployments en lecture).
GITHUB_TOKEN=demo-github-token
GITHUB_OWNER=jchubassistance-collab
GITHUB_REPOSITORY=jchub
# Modèle Gemini qui écrit le code des outils (par défaut : gemini-flash-latest)
GEMINI_TOOL_MODEL=gemini-flash-latest
# Secours si Gemini échoue (quota, panne, réponse illisible) : modèle OpenRouter gratuit.
# Vide = poolside/laguna-s-2.1:free puis nvidia/nemotron-3-super-120b-a12b:free.
OPENROUTER_TOOL_MODEL=
JCHUB_ADOBE_PDF_CLIENT_ID=demo-adobe-client-id
JCHUB_ADOBE_PDF_CLIENT_SECRET=demo-adobe-client-secret

# Cloudinary / media
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo-cloud
CLOUDINARY_API_KEY=demo-cloudinary-api-key
CLOUDINARY_API_SECRET=demo-cloudinary-api-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://demo-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=demo-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=demo-supabase-service-role-key

# Giscus / comments
NEXT_PUBLIC_GISCUS_REPOSITORY=your-user/your-repo
NEXT_PUBLIC_GISCUS_CATEGORY=General


FACEBOOK_REDIRECT_URI=https://nom-aleatoire.trycloudflare.com/api/auth/facebook/callback